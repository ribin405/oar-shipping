# Copy to .env.local for local development. Never commit real values.

# Public origin of the site (used for canonical URLs, sitemap, robots and Open Graph).
# Canonical production origin, e.g. https://your-domain (https, no path). Local development falls back to
# http://localhost:3000. In a production build it must be set to a public https origin: if it is missing,
# invalid, not https or a loopback host, the site emits no canonical URLs or sitemap entries, marks pages
# noindex and robots.txt disallows crawling (it never falls back to localhost). Use only the real OAR domain.
NEXT_PUBLIC_SITE_URL=

# Reserved for a later phase. Not read by the application yet.
NEXT_PUBLIC_GA_ID=

# Quote request delivery (server-only: never prefix with NEXT_PUBLIC_).
# All three must be set for the quote form to deliver; if any is missing the form
# fails safely with a generic message and nothing is sent. The site still builds.
# API key for the email provider (Resend).
RESEND_API_KEY=
# Verified OAR mailbox that receives quote requests.
OAR_RFQ_RECIPIENT_EMAIL=
# Sender on a domain verified with the provider, e.g. a plain address or "Name <address>".
OAR_RFQ_FROM_EMAIL=
